    <nav class="github-nav-links">
      <a href="#">Platform <span>⌄</span></a>
      <a href="#">Solutions <span>⌄</span></a>
      <a href="#">Resources <span>⌄</span></a>
      <a href="#">Open Source <span>⌄</span></a>
      <a href="#">Enterprise <span>⌄</span></a>
