  <main class="github-hero">

    <div class="hero-content">

      <h1>
        The future of building
        <br>
        happens together
      </h1>

      <p class="hero-description">
        Tools and trends evolve, but collaboration endures. With GitHub,
        developers, agents, and code come together on one platform.
      </p>


      <div class="hero-actions">

        <form class="email-form">
          <input
            type="email"
            placeholder="Enter your email"
            aria-label="Email address"
          >

          <button type="submit">
            Sign up for GitHub
          </button>
        </form>

        <a href="#" class="copilot-button">
          Download GitHub Copilot app
        </a>

      </div>

    </div>


    <div class="hero-art" aria-hidden="true">

      <div class="glow"></div>

      <div class="character character-left">
        <div class="character-face">
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="character character-right">
        <div class="character-face">
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="star star-1">✦</div>
      <div class="star star-2">✦</div>
      <div class="star star-3">✦</div>
      <div class="star star-4">✦</div>
      <div class="star star-5">✦</div>

